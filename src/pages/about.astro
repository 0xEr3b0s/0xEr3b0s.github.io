---
import XpLayout from '../layouts/XpLayout.astro';
import Window from '../components/xp/Window.astro';
import AboutBody from '../components/xp/AboutBody.astro';
import ContactBody from '../components/xp/ContactBody.astro';
import { profile, site } from '../data/site';
---

<XpLayout title="About" description={`About ${site.name} - ${profile.shortIntro}`}>
	<main class="page-stage" id="main" tabindex="-1">
		<Window id="about" title="About" icon="user" mode="page">
			<AboutBody level={1} />
			<div class="doc" id="contact">
				<h2 class="doc-sub">Contact</h2>
				<ContactBody />
			</div>
		</Window>
	</main>
</XpLayout>
