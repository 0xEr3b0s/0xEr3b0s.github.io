---
import { getCollection } from 'astro:content';
import XpLayout from '../layouts/XpLayout.astro';
import Window from '../components/xp/Window.astro';
import DesktopIcons from '../components/xp/DesktopIcons.astro';
import ExplorerList from '../components/xp/ExplorerList.astro';
import ProjectBody from '../components/xp/ProjectBody.astro';
import AboutBody from '../components/xp/AboutBody.astro';
import ContactBody from '../components/xp/ContactBody.astro';
import BrowserFrame from '../components/xp/BrowserFrame.astro';
import GitHubIndexBody from '../components/xp/GitHubIndexBody.astro';
import { getRepoStats } from '../data/github';
import { getGitHubSnapshot } from '../data/github-snapshot';
import { profile, site } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const stats = await getRepoStats(projects.map((p) => p.data.github).filter(Boolean));
const snapshot = await getGitHubSnapshot(site.handle);
---

<XpLayout desktop>
	<main id="main" tabindex="-1">
		<div class="desktop" id="desktop">
			<h1 class="sr-only">0xEr3b0s - desktop</h1>
			<DesktopIcons />
			<aside class="id-card" aria-label={`About ${site.name}`}>
				<p class="id-name">{site.name}</p>
				<p class="id-role">{profile.shortIntro}</p>
				<p class="id-status">{profile.currentStatus}</p>
				<p class="id-meta">{profile.location}</p>
				<p class="id-hint">Open an icon to get started.</p>
			</aside>
			<div class="windows" id="windows"></div>
		</div>
	</main>

	<template id="tpl-index">
		<ExplorerList projects={projects} level={2} />
	</template>
	<template id="tpl-gh-index" data-login={snapshot.login} data-repos={snapshot.repos.map((r) => r.name).join(',')}>
		<GitHubIndexBody snapshot={snapshot} level={2} />
	</template>
	<template id="tpl-win-ie">
		<Window id="ie" title="Internet Explorer" icon="ie" hidden>
			<BrowserFrame mode="app" />
		</Window>
	</template>
	<template id="tpl-win-about">
		<Window id="about" title="About" icon="user" hidden>
			<AboutBody level={2} />
		</Window>
	</template>
	<template id="tpl-win-contact">
		<Window id="contact" title="Contact" icon="mail" hidden>
			<ContactBody />
		</Window>
	</template>
	{
		projects.map((p) => (
			<template data-project={p.id} data-title={p.data.title}>
				<ProjectBody project={p} stat={stats[p.data.github]} level={2} />
			</template>
		))
	}
</XpLayout>
