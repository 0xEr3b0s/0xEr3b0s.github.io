---
import { getCollection } from 'astro:content';
import XpLayout from '../../layouts/XpLayout.astro';
import Window from '../../components/xp/Window.astro';
import BrowserFrame from '../../components/xp/BrowserFrame.astro';
import ProjectBody from '../../components/xp/ProjectBody.astro';
import { getRepoStats } from '../../data/github';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const stats = project.data.github ? await getRepoStats([project.data.github]) : {};
---

<XpLayout title={project.data.title} description={project.data.description}>
	<main class="page-stage" id="main" tabindex="-1">
		<Window id="ie" title="Internet Explorer" icon="ie" mode="page">
			<BrowserFrame mode="page" address={`http://0xnirmata/projects/${project.id}`}>
				<ProjectBody project={project} stat={stats[project.data.github]} level={1} />
			</BrowserFrame>
		</Window>
	</main>
</XpLayout>
