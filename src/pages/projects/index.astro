---
import { getCollection } from 'astro:content';
import XpLayout from '../../layouts/XpLayout.astro';
import Window from '../../components/xp/Window.astro';
import BrowserFrame from '../../components/xp/BrowserFrame.astro';
import ExplorerList from '../../components/xp/ExplorerList.astro';

const projects = await getCollection('projects');
---

<XpLayout title="Projects" description="Projects by 0xNirmata.">
	<main class="page-stage" id="main" tabindex="-1">
		<Window id="ie" title="Internet Explorer" icon="ie" mode="page">
			<BrowserFrame mode="page" address="http://0xnirmata/projects" back="/">
				<ExplorerList projects={projects} level={1} />
			</BrowserFrame>
		</Window>
	</main>
</XpLayout>
