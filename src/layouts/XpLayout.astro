---
import '../styles/xp.css';
import Taskbar from '../components/xp/Taskbar.astro';
import StartMenu from '../components/xp/StartMenu.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	desktop?: boolean;
}

const { title, description = site.description, desktop = false } = Astro.props;
const pageTitle = title ? `${title} - ${site.name}` : site.title;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = new URL('/og.png', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0b0f0c" />
		<title>{pageTitle}</title>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<meta name="description" content={description} />
		{canonicalURL && <link rel="canonical" href={canonicalURL} />}
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
	</head>
	<body class={desktop ? 'is-desktop' : 'is-page'}>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
		<StartMenu />
		<Taskbar />
		<script>
			import '../scripts/main';
		</script>
	</body>
</html>
