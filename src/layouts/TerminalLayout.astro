---
import '../styles/terminal.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	wide?: boolean;
}

const { title, description = site.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{canonicalURL && <link rel="canonical" href={canonicalURL} />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<Header />
		<main class={wide ? 'wide' : undefined}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
