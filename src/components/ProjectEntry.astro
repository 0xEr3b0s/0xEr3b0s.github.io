---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { id, data } = project;
const hasGithub = data.github.length > 0;
// Pipe-delimited: '|' cannot appear in a tag, so multi-word techs
// like "Argo CD" stay one token for the filter on /projects.
const techList = data.technologies.map((t) => t.toLowerCase()).join('|');
---

<li class="project-entry" data-category={data.category} data-techs={techList}>
	<h3 class="project-title"><span class="dim">$ cat</span> {data.title}</h3>
	<div class="meta">
		<span class="legend-item">
			<span class={`legend-swatch status-${data.status}`} aria-hidden="true">■</span>
			<span class="legend-label">{data.status}</span>
		</span>
		<span class="meta-year">{data.year}</span>
	</div>
	{data.technologies.length > 0 && <p class="project-techs">{data.technologies.join(' / ')}</p>}
	<p class="project-desc">{data.description}</p>
	<div class="project-links">
		{
			hasGithub ? (
				<a href={data.github} target="_blank" rel="noopener noreferrer">
					[github]
				</a>
			) : (
				<span class="dim">[private / on request]</span>
			)
		}
		{!compact && <a href={`/projects/${id}`}>[details]</a>}
	</div>
</li>
