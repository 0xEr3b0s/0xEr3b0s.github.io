---
import { nav } from '../data/site';
---

<header class="site-header">
	<nav aria-label="Primary">
		<a href="/" class="brand">[0xEr3b0s]</a><span class="crt-cursor" aria-hidden="true"></span>
		{
			nav.map((item) => (
				<a
					href={item.href}
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noopener noreferrer' : undefined}
				>
					{item.label}
				</a>
			))
		}
		<button id="crt-toggle" type="button" class="crt-toggle" aria-pressed="true" title="Toggle CRT effect">[crt]</button>
	</nav>
</header>

<script is:inline>
	(function () {
		var btn = document.getElementById('crt-toggle');
		if (!btn) return;
		function sync() {
			var on = document.documentElement.classList.contains('crt');
			btn.setAttribute('aria-pressed', on ? 'true' : 'false');
			btn.textContent = on ? '[crt]' : '[crt off]';
		}
		btn.addEventListener('click', function () {
			var on = document.documentElement.classList.toggle('crt');
			try {
				localStorage.setItem('crt', on ? '1' : '0');
			} catch (e) {}
			sync();
		});
		sync();
	})();
</script>
