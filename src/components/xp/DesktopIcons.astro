---
import { apps } from '../../config/desktop';
import Icon from './Icon.astro';
---

<nav class="desktop-icons" aria-label="Desktop">
	<ul>
		{
			apps.map((a) => (
				<li>
					<a
						class="desktop-icon"
						href={a.href}
						data-open={a.windowId ?? undefined}
					>
						<Icon name={a.icon} size={40} />
						<span class="desktop-icon-label">{a.label}{a.external && <span class="sr-only"> (github.com)</span>}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
