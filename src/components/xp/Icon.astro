---
import type { IconName } from '../../config/desktop';

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 32 } = Astro.props;
---

<svg
	class="xp-icon"
	width={size}
	height={size}
	viewBox="0 0 32 32"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'folder' && (
			<>
				<path d="M2 7h10l3 3h15v17H2z" style="fill:var(--ic-folder-dark)" />
				<path d="M2 12h28v15H2z" style="fill:var(--ic-folder)" />
				<path d="M2 12h28v3H2z" style="fill:var(--ic-folder-light)" />
			</>
		)
	}
	{
		name === 'user' && (
			<>
				<rect x="1" y="1" width="30" height="30" rx="4" style="fill:var(--ic-blue)" />
				<circle cx="16" cy="12" r="5" style="fill:var(--ic-skin)" />
				<path d="M6 28c0-6 4-9 10-9s10 3 10 9z" style="fill:var(--ic-white)" />
			</>
		)
	}
	{
		name === 'github' && (
			<>
				<rect x="1" y="1" width="30" height="30" rx="5" style="fill:var(--ic-dark)" />
				<g transform="translate(4 4) scale(1.5)">
					<path
						style="fill:var(--ic-white)"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
					/>
				</g>
			</>
		)
	}
	{
		name === 'mail' && (
			<>
				<rect x="2" y="7" width="28" height="19" rx="2" style="fill:var(--ic-white);stroke:var(--ic-blue);stroke-width:2" />
				<path d="M3 9l13 10L29 9" style="fill:none;stroke:var(--ic-blue);stroke-width:2" />
			</>
		)
	}
	{
		name === 'ie' && (
			<>
				<circle cx="16" cy="16" r="11" style="fill:var(--ic-blue)" />
				<text x="16" y="23" text-anchor="middle" font-size="22" font-weight="700" font-family="Georgia, serif" style="fill:var(--ic-white)">e</text>
				<ellipse cx="16" cy="16" rx="14" ry="5" transform="rotate(-25 16 16)" style="fill:none;stroke:var(--ic-gold);stroke-width:2" />
			</>
		)
	}
	{
		name === 'flag' && (
			<>
				<path d="M3 6c4-2 7-1 11 0v10c-4-1-7-2-11 0z" style="fill:var(--ic-red)" />
				<path d="M16 6c4 1 7 2 12 0v10c-5 2-8 1-12 0z" style="fill:var(--ic-green)" />
				<path d="M3 18c4-2 7-1 11 0v10c-4-1-7-2-11 0z" style="fill:var(--ic-blue)" />
				<path d="M16 18c4 1 7 2 12 0v10c-5 2-8 1-12 0z" style="fill:var(--ic-gold)" />
			</>
		)
	}
	{
		name === 'doc' && (
			<>
				<path d="M6 2h14l6 6v22H6z" style="fill:var(--ic-white);stroke:var(--ic-dark);stroke-width:1.5" />
				<path d="M20 2v6h6" style="fill:var(--ic-folder-light);stroke:var(--ic-dark);stroke-width:1.5" />
				<path d="M10 14h12M10 18h12M10 22h8" style="stroke:var(--ic-blue);stroke-width:1.5" />
			</>
		)
	}
</svg>
