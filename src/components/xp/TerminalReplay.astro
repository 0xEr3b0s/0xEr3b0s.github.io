---
import type { Replay } from '../../data/replays';
import { jsonForScript, toneOf, transcript } from '../../scripts/replay';

interface Props {
	replay: Replay;
}

const { replay } = Astro.props;
const lines = transcript(replay.steps);
const title = `Terminal - ${replay.label}`;
---

<figure class="tr" data-replay data-state="idle" aria-label={title}>
	<div class="tr-bar">{title}</div>
	<div class="tr-screen" role="region" aria-label={`${title}, transcript`} tabindex="0">
		<div class="tr-static">
			{
				lines.map((line) => (
					<div class="tr-line">
						{line.map((seg) => (
							<span class={`tr-${toneOf(seg.tone)}`}>{seg.text}</span>
						))}
					</div>
				))
			}
		</div>
		<div class="tr-live" aria-hidden="true"></div>
	</div>
	<div class="tr-controls">
		<button type="button" class="tr-btn" data-tr-action="pause" hidden>Pause</button>
		<button type="button" class="tr-btn" data-tr-action="replay" hidden>Replay</button>
	</div>
	<figcaption class="tr-caption">Replay rebuilt from the source code, not a live run.</figcaption>
	<script is:inline type="application/json" set:html={jsonForScript(replay.steps)} />
</figure>
